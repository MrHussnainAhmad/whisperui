{
  "expo": {
    "name": "Whisper",
    "slug": "whsiperapp",
    "icon": "./assets/icon.png",
    "version": "1.0.1",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hussnainahmadsahi.chat"
    },
    "android": {
      "package": "com.hussnainahmadsahi.chat",
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0F14"
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 28,
            "usesCleartextTraffic": false
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B0F14",
          "imageWidth": 200
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow access to select photos to share in chat.",
          "cameraPermission": "Allow access to camera to take photos for chat.",
          "microphonePermission": "Allow Whisper to record audio when you record a video."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow camera access to scan a Whisper invite QR code.",
          "microphonePermission": "Allow Whisper to record audio when you record a video.",
          "recordAudioAndroid": true
        }
      ],
      "expo-sharing",
      "expo-status-bar",
      "expo-font"
    ],
    "extra": {
      "serverUrl": "https://mywhisperchat.duckdns.org",
      "eas": {
        "projectId": "b5273018-113e-442c-aa2e-5699a1d7f842"
      }
    },
    "owner": "accformes-team",
    "scheme": "whisperchat"
  }
}
