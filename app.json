{
  "expo": {
    "name": "Whisper",
    "slug": "whisper",
    "icon": "./assets/icon.png",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0F14"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hussnainahmadsahi.chat"
    },
    "android": {
      "package": "com.hussnainahmadsahi.chat",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0F14"
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 28,
            "usesCleartextTraffic": false
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow access to select photos to share in chat.",
          "cameraPermission": "Allow access to camera to take photos for chat."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow camera access to scan a Whisper invite QR code.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "034c9b6f-c804-42e3-bc79-ced05105e270"
      }
    },
    "owner": "hussnainahmadsahi"
  }
}
