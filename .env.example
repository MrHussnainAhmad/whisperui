# Whisper Mobile — copy to .env and adjust
# Variables must start with EXPO_PUBLIC_ to be available in the app

# Server URL (Socket.IO). Leave empty for auto-detect in dev:
#   Android emulator → http://10.0.2.2:3000
#   iOS simulator    → http://localhost:3000
#
# Physical phone on same WiFi as your PC:
# EXPO_PUBLIC_SERVER_URL=http://192.168.1.100:3000
#
# Production / hosted backend (HTTPS required for production builds):
# EXPO_PUBLIC_SERVER_URL=https://whisperchatapp.duckdns.org

# Explicit local Android opt-in for app.config.js (never set in production):
ALLOW_CLEARTEXT_DEV=false
# For local Android emulator HTTP only, change this to true. Never use true in
# preview or production builds.

EXPO_PUBLIC_SERVER_URL=https://www.domain.com